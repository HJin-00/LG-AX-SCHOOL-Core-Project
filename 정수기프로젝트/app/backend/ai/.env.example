# 환경변수 이름 안내. 실행 전 PowerShell에서 $env:AGENT_MODE = "stub"처럼 설정.
# 이 파일은 자동으로 로드하지 않습니다. API 키를 적지 마세요.
AGENT_MODE=
AGENT_TIMEOUT_SECONDS=
SESSION_TTL_SECONDS=
MAX_SESSIONS=
HISTORY_TURNS=
BRIEF_ROOT=

# FastAPI/MCP 모두 같은 절대 경로 사용. 미설정 시 프로젝트 내부 기본 경로.
CONSENT_DB=
# MySQL 모드: CONSENT_DB는 비워두고 양 서버에 동일 값 설정
CONSENT_BACKEND=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# n8n 연결시 AGENT_MODE=live 설정
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
