# 이 파일을 app.env로 복사해 본인 PC에서만 설정합니다.
AGENT_MODE=langchain
LLM_PROVIDER=openai
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
LLM_MODEL=
AGENT_TIMEOUT_SECONDS=90
SESSION_TTL_SECONDS=1800
LANGSMITH_TRACING=false

# 공개 검수 문서의 하이브리드 검색. 대화 모델과 독립된 임베딩 설정.
RAG_SEARCH_MODE=hybrid
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_MIN_SIMILARITY=0.30
RAG_RERANK=true
RAG_RERANK_MODEL=gpt-4.1-mini
# 비우면 app/backend/ai/runtime/rag 에 로컬 Chroma 저장
RAG_VECTOR_PATH=

# 로컬 시연은 sqlite로 시작 가능. 팀 운영 설정은 담당자와 확인 후 mysql 선택.
CONSENT_BACKEND=mysql
# MySQL 사용 시 아래 값 입력. 비밀번호는 공유하지 않습니다.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=water_demo
MYSQL_USER=water_app
MYSQL_PASSWORD=

# 일반 실행에서는 비워두고 한국 현재 날짜 사용. 고정 평가에만 지정.
EVALUATION_REFERENCE_DATE=


# 시연: 계산용 2모델 + 공식 요금 참고 비교 4모델. 전체 자료 탐색은 all.
CATALOG_SCOPE=comparison_ready
